# Digital Memory Card (CardNG) Configuration
PORT=4000
HOST=0.0.0.0

# Security Secret for HMAC Signed Stream URLs & Session Tokens
APP_SECRET=cardng-super-secret-hmac-key-2026-nigeria

# Storage Configuration (Local 200GB Oracle Block Volume or Custom Path)
STORAGE_ROOT=./storage

# OPay & PalmPay Merchant / Personal Account Details (Displayed to Users)
OPAY_ACCOUNT_NUMBER=8012345678
OPAY_ACCOUNT_NAME=CARDNG DIGITAL STORAGE
PALMPAY_ACCOUNT_NUMBER=8012345678
PALMPAY_ACCOUNT_NAME=CARDNG DIGITAL STORAGE

# Optional: Telegram Bot for 1-Tap Mobile Payment Approval
# Create a bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN
# Get your chat ID via @userinfobot to set TELEGRAM_ADMIN_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional: Paystack Starter Business Secret Key (No CAC needed up to N2,000,000)
PAYSTACK_SECRET_KEY=
